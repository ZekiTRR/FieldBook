{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "target": "ES2018",
    "allowJs": false,
    "noImplicitAny": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "moduleResolution": "node",
    "importHelpers": false,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["DOM", "DOM.Iterable", "ES2021"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
