{
  "name": "fieldbook",
  "version": "1.0.0",
  "description": "Interactive notebook for Obsidian",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs dev",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "notebook",
    "canvas",
    "drawing",
    "journal"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.14.4",
    "typescript": "^5.7.0"
  }
}
